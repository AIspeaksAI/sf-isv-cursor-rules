### 4. Security Best Practices

**Secure Agent Action Handler:**
```apex
public class SecureAgentHandler {
    @InvocableMethod(label='Secure Agent Action')
    public static List<SecureResponse> processSecurely(List<SecureRequest> requests) {
        List<SecureResponse> responses = new List<SecureResponse>();
        
        for (SecureRequest request : requests) {
            try {
                // Input validation
                if (!isValidInput(request)) {
                    responses.add(new SecureResponse(
                        'Invalid input provided.',
                        'validation_error',
                        null
                    ));
                    continue;
                }
                
                // Security checks
                if (!passesSecurityChecks(request)) {
                    responses.add(new SecureResponse(
                        'Security check failed.',
                        'security_error',
                        null
                    ));
                    continue;
                }
                
                // Process with audit logging
                String result = processWithAudit(request);
                
                responses.add(new SecureResponse(result, 'success', null));
                
            } catch (Exception e) {
                logSecurityEvent(request, e);
                responses.add(new SecureResponse(
                    'An error occurred processing your request.',
                    'error',
                    null
                ));
            }
        }
        
        return responses;
    }
    
    private static Boolean isValidInput(SecureRequest request) {
        // Validate input format and content
        return !String.isBlank(request.input) && 
               request.input.length() <= 1000 &&
               !containsMaliciousContent(request.input);
    }
    
    private static Boolean containsMaliciousContent(String input) {
        String lowerInput = input.toLowerCase();
        return lowerInput.contains('ignore previous instructions') ||
               lowerInput.contains('system:') ||
               lowerInput.contains('override') ||
               lowerInput.contains('<script>');
    }
    
    private static Boolean passesSecurityChecks(SecureRequest request) {
        // Check user permissions, rate limiting, etc.
        return true; // Placeholder
    }
    
    private static void logSecurityEvent(SecureRequest request, Exception e) {
        // Log security events for monitoring
        System.debug('Security Event: ' + e.getMessage());
    }
}
```

### 5. Data Integration Patterns

**Dynamic Data Grounding:**
```apex
public class DataGroundingService {
    @InvocableMethod(label='Ground Data for AI')
    public static List<GroundingResponse> groundData(List<GroundingRequest> requests) {
        List<GroundingResponse> responses = new List<GroundingResponse>();
        
        for (GroundingRequest request : requests) {
            try {
                Map<String, Object> groundedData = new Map<String, Object>();
                
                // Ground with Salesforce data
                if (request.recordId != null) {
                    groundedData.put('Record', getRecordData(request.recordId, request.objectType));
                }
                
                // Ground with related data
                if (request.includeRelated) {
                    groundedData.put('RelatedData', getRelatedData(request.recordId));
                }
                
                // Ground with user context
                groundedData.put('UserContext', getUserContext());
                
                // Ground with business context
                groundedData.put('BusinessContext', getBusinessContext(request.context));
                
                responses.add(new GroundingResponse(groundedData, 'success', null));
                
            } catch (Exception e) {
                responses.add(new GroundingResponse(
                    new Map<String, Object>(),
                    'error',
                    e.getMessage()
                ));
            }
        }
        
        return responses;
    }
    
    private static Map<String, Object> getRecordData(Id recordId, String objectType) {
        // Dynamic SOQL based on object type
        String query = 'SELECT Id, Name FROM ' + objectType + ' WHERE Id = :recordId';
        SObject record = Database.query(query);
        
        Map<String, Object> recordData = new Map<String, Object>();
        for (String field : record.getSObjectType().getDescribe().fields.getMap().keySet()) {
            recordData.put(field, record.get(field));
        }
        
        return recordData;
    }
    
    private static Map<String, Object> getUserContext() {
        User currentUser = [SELECT Id, Name, Email, Profile.Name FROM User WHERE Id = :UserInfo.getUserId()];
        return new Map<String, Object>{
            'Name' => currentUser.Name,
            'Email' => currentUser.Email,
            'Profile' => currentUser.Profile.Name
        };
    }
}
```

### 6. Testing Patterns

**Comprehensive Test Coverage:**
```apex
@IsTest
public class GenAITestSuite {
    @TestSetup
    static void setup() {
        // Create test data for AI scenarios
        Account testAccount = new Account(Name = 'Test Account');
        insert testAccount;
        
        Contact testContact = new Contact(
            FirstName = 'John',
            LastName = 'Doe',
            Email = 'john.doe@test.com',
            AccountId = testAccount.Id
        );
        insert testContact;
    }
    
    @IsTest
    static void testPromptTemplateAction() {
        Contact testContact = [SELECT Id FROM Contact LIMIT 1];
        
        PromptTemplateAction.PromptRequest request = 
            new PromptTemplateAction.PromptRequest();
        request.templateName = 'Customer_Service_Template';
        request.userInput = 'I need help with my account';
        request.recordId = testContact.Id;
        
        Test.startTest();
        List<PromptTemplateAction.PromptResponse> responses = 
            PromptTemplateAction.generateResponse(new List<PromptTemplateAction.PromptRequest>{request});
        Test.stopTest();
        
        System.assertEquals(1, responses.size());
        System.assertEquals('success', responses[0].status);
        System.assertNotEquals(null, responses[0].response);
    }
    
    @IsTest
    static void testAgentAction() {
        AgentAction.ActionRequest request = new AgentAction.ActionRequest();
        request.input = 'Test input for agent';
        
        Test.startTest();
        List<AgentAction.ActionResponse> responses = 
            AgentAction.execute(new List<AgentAction.ActionRequest>{request});
        Test.stopTest();
        
        System.assertEquals(1, responses.size());
        System.assertEquals('success', responses[0].status);
    }
    
    @IsTest
    static void testSecurityValidation() {
        SecureAgentHandler.SecureRequest request = new SecureAgentHandler.SecureRequest();
        request.input = '<script>alert("xss")</script>';
        
        Test.startTest();
        List<SecureAgentHandler.SecureResponse> responses = 
            SecureAgentHandler.processSecurely(new List<SecureAgentHandler.SecureRequest>{request});
        Test.stopTest();
        
        System.assertEquals(1, responses.size());
        System.assertEquals('validation_error', responses[0].status);
    }
}
