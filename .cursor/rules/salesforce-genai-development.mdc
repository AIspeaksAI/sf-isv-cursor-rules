public class AgentAction {
    @InvocableMethod(
        label='Agent Action Name'
        description='Clear description of what this action does'
        category='Agent Actions'
    )
    public static List<ActionResponse> execute(List<ActionRequest> requests) {
        List<ActionResponse> responses = new List<ActionResponse>();
        
        for (ActionRequest request : requests) {
            try {
                // Validate and sanitize inputs
                validateAndSanitizeInput(request);
                
                // Check permissions
                if (!hasRequiredPermissions(request)) {
                    responses.add(new ActionResponse(
                        'You do not have permission to perform this action.',
                        'permission_denied',
                        null
                    ));
                    continue;
                }
                
                // Execute business logic
                String result = executeBusinessLogic(request);
                
                // Format response for agent
                String formattedResponse = formatForAgent(result, request);
                
                responses.add(new ActionResponse(formattedResponse, 'success', null));
                
            } catch (Exception e) {
                logAgentError('AgentAction', e, request);
                responses.add(new ActionResponse(
                    'I encountered an error while processing your request.',
                    'error',
                    e.getMessage()
                ));
            }
        }
        
        return responses;
    }
    
    private static void validateAndSanitizeInput(ActionRequest request) {
        if (String.isBlank(request.input)) {
            throw new IllegalArgumentException('Input is required');
        }
        
        // Sanitize input to prevent injection attacks
        request.input = request.input.replaceAll('[<>"\']', '');
    }
    
